{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/bootstrap-ai-project/test-observation.schema.json",
  "title": "Spectra TDD test observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "observed",
    "event",
    "phase",
    "task_id",
    "evidence_key",
    "framework",
    "command_id",
    "command",
    "cwd",
    "duration_ms",
    "status",
    "failure_kind",
    "counts",
    "cases",
    "failure_summary",
    "redacted",
    "raw_output_stored"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "test-observation"
    },
    "observed": {
      "const": true
    },
    "event": {
      "enum": [
        "PostToolUse",
        "PostToolUseFailure"
      ]
    },
    "phase": {
      "enum": [
        "red",
        "green",
        "refactor",
        "unclassified"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "framework": {
      "enum": [
        "vitest",
        "jest",
        "pytest",
        "xunit",
        "go",
        "rspec",
        "cargo"
      ]
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "cwd": {
      "type": "string"
    },
    "duration_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "interrupted",
        "unparsed"
      ]
    },
    "failure_kind": {
      "enum": [
        "assertion",
        "compile",
        "infrastructure",
        "timeout",
        "unknown",
        null
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "failed",
        "skipped",
        "total"
      ],
      "properties": {
        "passed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "failed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "skipped": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "skipped"
            ]
          }
        }
      }
    },
    "failure_summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "redacted": {
      "type": "boolean"
    },
    "raw_output_stored": {
      "const": false
    }
  }
}
