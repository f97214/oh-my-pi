{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/bootstrap-ai-project/test-observer-config.schema.json",
  "title": "Spectra TDD observer runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "framework",
    "commands",
    "report_pattern",
    "max_failure_summary_chars",
    "secret_rules",
    "required_report_marker",
    "required_summary_heading"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "framework": {
      "enum": [
        "vitest",
        "jest",
        "pytest",
        "xunit",
        "go",
        "rspec",
        "cargo"
      ]
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "base"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$",
            "maxLength": 128
          },
          "base": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "report_pattern": {
      "const": "openspec/changes/{change_name}/test-evidence.md"
    },
    "max_failure_summary_chars": {
      "type": "integer",
      "minimum": 80,
      "maximum": 2000
    },
    "secret_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "pattern"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "flags": {
            "type": "string"
          },
          "capture_group": {
            "type": "integer",
            "minimum": 0
          },
          "redactor": {
            "type": "string"
          }
        }
      }
    },
    "required_report_marker": {
      "const": "<!-- bootstrap-ai-project:tdd-evidence -->"
    },
    "required_summary_heading": {
      "const": "## TDD 測試摘要"
    }
  }
}
