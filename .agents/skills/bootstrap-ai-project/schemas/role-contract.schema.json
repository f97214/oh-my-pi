{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/bootstrap-ai-project/role-contract.schema.json",
  "title": "bootstrap-ai-project canonical role contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "description",
    "trigger",
    "capabilities",
    "instructions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "enum": ["implementer", "test-engineer", "doc-writer", "git-commit"]
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "trigger": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write", "run_tests", "commit"],
      "properties": {
        "write": { "type": "boolean" },
        "run_tests": { "type": "boolean" },
        "commit": { "type": "boolean" }
      }
    },
    "instructions": { "type": "string", "minLength": 1 }
  }
}
